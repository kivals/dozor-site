# Public site URL (used for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where leads are delivered: telegram | email | crm
LEAD_TRANSPORT=telegram

# Telegram transport
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email transport (Yandex 360: smtp.yandex.ru, port 465, app password)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=info@el-dozor.ru
SMTP_PASSWORD=
# Sender address (must be allowed to "send as"); defaults to SMTP_USER
SMTP_FROM=info@el-dozor.ru
LEAD_EMAIL_TO=info@el-dozor.ru

# Close the site from search engines (preview/demo deploys): true | false
NEXT_PUBLIC_NOINDEX=false

# Yandex.Metrika counter id (leave empty to disable the counter)
NEXT_PUBLIC_YM_COUNTER_ID=112564611

# Yandex Maps (client-side widget)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
